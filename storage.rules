rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // In-app announcement flyers
    match /announcements/{allPaths=**} {
      // Public read so mobile app students can view the flyer image
      allow read: if true;
      // Authenticated admin can upload / delete
      allow write: if request.auth != null;
    }

    // Default rule for all other assets
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
