{
  "hosting": {
    "site": "brainsquard-studio-b458b",
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "server.ps1",
      "run_portal.bat",
      "deploy_to_firebase.bat",
      "functions/**"
    ],
    "rewrites": [
      {
        "source": "/api/generateQuestions",
        "function": {
          "functionId": "generateQuestions",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/paystackWebhook",
        "function": {
          "functionId": "paystackWebhook",
          "region": "us-central1"
        }
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ]
}
